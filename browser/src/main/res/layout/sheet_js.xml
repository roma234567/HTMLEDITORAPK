<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_handle" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/js_title"
        android:textColor="@color/ink"
        android:textSize="17sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/jsCode"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_field"
        android:fontFamily="monospace"
        android:gravity="top|start"
        android:hint="@string/js_hint"
        android:inputType="textMultiLine|textNoSuggestions"
        android:padding="12dp"
        android:scrollbars="vertical"
        android:textColor="@color/ink"
        android:textColorHint="@color/ink2"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/jsName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_field"
        android:hint="@string/js_save_hint"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:padding="10dp"
        android:singleLine="true"
        android:textColor="@color/ink"
        android:textColorHint="@color/ink2"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnJsRun"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.4"
            android:background="@drawable/bg_btn"
            android:text="@string/js_run"
            android:textAllCaps="false"
            android:textColor="@color/accent_on"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnJsWebsql"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_btn_ghost"
            android:text="@string/js_websql"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnJsSave"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_btn_ghost"
            android:text="@string/js_save"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/js_result"
        android:textColor="@color/ink"
        android:textSize="14sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_field"
        android:padding="8dp">

        <TextView
            android:id="@+id/jsResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/ink"
            android:textSize="12sp" />
    </ScrollView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/js_snippets"
        android:textColor="@color/ink"
        android:textSize="14sp"
        android:textStyle="bold" />

    <ScrollView
        android:id="@+id/jsListScroll"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_field"
        android:padding="4dp">

        <LinearLayout
            android:id="@+id/jsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <Button
        android:id="@+id/btnSheetClose"
        style="@style/GhostButton"
        android:layout_marginTop="12dp"
        android:text="@string/close" />
</LinearLayout>
