<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="16dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_handle" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="4dp"
        android:text="@string/menu_title"
        android:textColor="@color/ink"
        android:textSize="17sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/rowCookies"
        style="@style/MenuRow"
        android:background="?attr/selectableItemBackground">

        <ImageView
            android:id="@+id/menuCookieIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_cookie"
            app:tint="@color/ink"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:text="@string/menu_cookies"
            android:textColor="@color/ink"
            android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowInspector"
        style="@style/MenuRow"
        android:background="?attr/selectableItemBackground">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_eye"
            app:tint="@color/ink"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:text="@string/menu_inspector"
            android:textColor="@color/ink"
            android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowJs"
        style="@style/MenuRow"
        android:background="?attr/selectableItemBackground">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_code"
            app:tint="@color/ink"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:text="@string/menu_js"
            android:textColor="@color/ink"
            android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowSql"
        style="@style/MenuRow"
        android:background="?attr/selectableItemBackground">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_db"
            app:tint="@color/ink"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:text="@string/menu_sql"
            android:textColor="@color/ink"
            android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowProxy"
        style="@style/MenuRow"
        android:background="?attr/selectableItemBackground">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_proxy"
            app:tint="@color/ink"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:text="@string/menu_proxy"
            android:textColor="@color/ink"
            android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowTheme"
        style="@style/MenuRow"
        android:background="?attr/selectableItemBackground">

        <ImageView
            android:id="@+id/menuThemeIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_moon"
            app:tint="@color/ink"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

        <TextView
            android:id="@+id/menuThemeLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:text="@string/menu_theme_dark"
            android:textColor="@color/ink"
            android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>
