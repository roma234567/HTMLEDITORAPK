<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_handle" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/cookies_title"
        android:textColor="@color/ink"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/cookiesHost"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/ink2"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/inputCookieName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_field"
        android:hint="@string/cookie_name"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:padding="12dp"
        android:singleLine="true"
        android:textColor="@color/ink"
        android:textColorHint="@color/ink2"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/inputCookieValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_field"
        android:hint="@string/cookie_value"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:padding="12dp"
        android:singleLine="true"
        android:textColor="@color/ink"
        android:textColorHint="@color/ink2"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/inputCookieDomain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_field"
        android:hint="@string/cookie_domain"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:padding="12dp"
        android:singleLine="true"
        android:textColor="@color/ink"
        android:textColorHint="@color/ink2"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <CheckBox
            android:id="@+id/chkHttpOnly"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cookie_httponly"
            android:textColor="@color/ink2"
            android:textSize="14sp" />

        <CheckBox
            android:id="@+id/chkSecure"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@string/cookie_secure"
            android:textColor="@color/ink2"
            android:textSize="14sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnCookieAddApply"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_btn"
        android:text="@string/cookie_add_apply"
        android:textAllCaps="false"
        android:textColor="@color/accent_on"
        android:textSize="15sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/cookie_section_site"
        android:textColor="@color/ink"
        android:textSize="14sp"
        android:textStyle="bold" />

    <ScrollView
        android:id="@+id/cookieListScroll"
        android:layout_width="match_parent"
        android:layout_height="130dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_field"
        android:padding="4dp">

        <LinearLayout
            android:id="@+id/cookieList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/cookie_section_ours"
        android:textColor="@color/ink"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/ourCookieList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/cookie_log"
        android:textColor="@color/ink"
        android:textSize="14sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="84dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_field"
        android:padding="8dp">

        <TextView
            android:id="@+id/cookieLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/ink2"
            android:textSize="12sp" />
    </ScrollView>

    <Button
        android:id="@+id/btnSheetClose"
        style="@style/GhostButton"
        android:layout_marginTop="12dp"
        android:text="@string/close" />
</LinearLayout>
