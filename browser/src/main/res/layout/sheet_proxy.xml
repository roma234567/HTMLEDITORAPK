<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_handle" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/proxy_title"
        android:textColor="@color/ink"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/proxyAddr"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="monospace"
        android:textColor="@color/accent"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnProxyToggle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.4"
            android:background="@drawable/bg_btn"
            android:text="@string/proxy_toggle_on"
            android:textAllCaps="false"
            android:textColor="@color/accent_on"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnProxyCopy"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_btn_ghost"
            android:text="@string/proxy_copy"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textSize="14sp" />
    </LinearLayout>

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/chkIntercept"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:minHeight="46dp"
        android:text="@string/proxy_intercept"
        android:textColor="@color/ink"
        android:textSize="14sp"
        app:thumbTint="@color/accent"
        app:trackTint="@color/glass_stroke"
        xmlns:app="http://schemas.android.com/apk/res-auto" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/proxy_log_lan"
        android:textColor="@color/ink"
        android:textSize="14sp"
        android:textStyle="bold" />

    <ScrollView
        android:id="@+id/proxyLogScroll"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_field"
        android:padding="8dp">

        <TextView
            android:id="@+id/proxyLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/ink2"
            android:textSize="12sp" />
    </ScrollView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/proxy_log_internal"
        android:textColor="@color/ink"
        android:textSize="14sp"
        android:textStyle="bold" />

    <ScrollView
        android:id="@+id/internalLogScroll"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_field"
        android:padding="8dp">

        <TextView
            android:id="@+id/internalLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/ink2"
            android:textSize="12sp" />
    </ScrollView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/proxy_note"
        android:textColor="@color/ink2"
        android:textSize="12sp" />

    <Button
        android:id="@+id/btnSheetClose"
        style="@style/GhostButton"
        android:layout_marginTop="12dp"
        android:text="@string/close" />
</LinearLayout>
