<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_handle" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/inspector_title"
        android:textColor="@color/ink"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/inspTarget"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="middle"
        android:singleLine="true"
        android:text="@string/inspector_no_target"
        android:textColor="@color/ink2"
        android:fontFamily="monospace"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnInspHtml"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_seg_on"
            android:text="@string/inspector_tab_html"
            android:textAllCaps="false"
            android:textColor="@color/accent_on"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnInspCss"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_seg_off"
            android:text="@string/inspector_tab_css"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textSize="14sp" />
    </LinearLayout>

    <EditText
        android:id="@+id/inspCode"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_field"
        android:fontFamily="monospace"
        android:gravity="top|start"
        android:inputType="textMultiLine|textNoSuggestions"
        android:minLines="7"
        android:padding="12dp"
        android:scrollbars="vertical"
        android:textColor="@color/ink"
        android:textColorHint="@color/ink2"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnInspApply"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.4"
            android:background="@drawable/bg_btn"
            android:text="@string/inspector_apply"
            android:textAllCaps="false"
            android:textColor="@color/accent_on"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnInspRepick"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_btn_ghost"
            android:text="@string/inspector_repick"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnInspCopy"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_btn_ghost"
            android:text="@string/inspector_copy"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnInspPick"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_ghost"
            android:text="@string/inspector_pick"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnInspStop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_btn_ghost"
            android:text="@string/inspector_stop"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textSize="14sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnSheetClose"
        style="@style/GhostButton"
        android:layout_marginTop="12dp"
        android:text="@string/close" />
</LinearLayout>
